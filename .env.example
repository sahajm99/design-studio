# Copy this file to .env and fill in what you have.
# Leave everything empty to run in demo mode on fake models.

# Text and vision model: a free Google AI Studio key, https://aistudio.google.com/apikey
GOOGLE_API_KEY=
STUDIO_GEMINI_MODEL=gemini-3.5-flash-lite

# Photo generation: a free Cloudflare account with Workers AI
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
STUDIO_CLOUDFLARE_IMAGE_MODEL=@cf/black-forest-labs/flux-2-klein-4b

# Web research before the draft (optional): a free Tavily key, https://app.tavily.com, 1,000 searches a month, no card
TAVILY_API_KEY=

# Paid photo models (optional, your own key and credits): used only by scripts/make_photos.py,
# which makes photo candidates with OpenAI's GPT Image models. The studio itself never reads it.
# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Paid photo models on Google (optional, your own key and billing): a Gemini API key from a
# Google project of its own, with billing on. Google's image models have no free tier, and
# billing applies to a whole project, so keep it apart from GOOGLE_API_KEY and the text calls stay free.
# https://aistudio.google.com/apikey
GOOGLE_IMAGE_API_KEY=

# The secret that encrypts the keys saved on the Settings page (optional): a Fernet key.
# Without it, the studio makes one in the database volume on first start. Make one with:
#   docker compose run --rm studio python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
STUDIO_SECRET_KEY=

# Which folder under brands/ to use
STUDIO_BRAND=hybridge

# Optional: auto, cloudflare, fake or none
# STUDIO_PHOTO_PROVIDER=auto
# Optional: how many references to analyse per minute
# STUDIO_ANALYSE_PER_MINUTE=10
