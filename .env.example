# Copy this file to .env and fill in what you have.
# Leave everything empty to run in demo mode on fake models.

# Text and vision model: a free Google AI Studio key, https://aistudio.google.com/apikey
GOOGLE_API_KEY=
STUDIO_GEMINI_MODEL=gemini-3.5-flash-lite

# Photo generation: a free Cloudflare account with Workers AI
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
STUDIO_CLOUDFLARE_IMAGE_MODEL=@cf/black-forest-labs/flux-2-klein-4b

# Web research before the draft (optional): a free Tavily key, https://app.tavily.com, 1,000 searches a month, no card
TAVILY_API_KEY=

# Which folder under brands/ to use
STUDIO_BRAND=hybridge

# Optional: auto, cloudflare, fake or none
# STUDIO_PHOTO_PROVIDER=auto
# Optional: how many references to analyse per minute
# STUDIO_ANALYSE_PER_MINUTE=10
