  "cards": [
    { "dot": "cyan", "title": "Who decides what happens next", "items": [
      "Code fixes each run's step order; agents only return typed JSON",
      "Manual mode: the designer's buttons start the next short run",
      "Auto mode: code owns rounds, photo budget, stop score and hard flags; the judge says continue or stop and what to change"
    ] },
    { "dot": "rose", "title": "Failure paths", "items": [
      "Gemini: HTTP retry on 429 and 5xx; a prompt draft that fails its contract is asked for once more",
      "Cloudflare: 180 s timeout, one retry; one failed sample does not fail the round",
      "Restart: running runs are marked interrupted and auto sessions return to manual"
    ] },
    { "dot": "amber", "title": "Demo mode and brands", "items": [
      "No keys: FakeLlm and a fake photo provider run the same agent code; tests run offline",
      "A brand is a folder; the renderer injects its colours, fonts and logo as CSS variables"
    ] }
  ]
